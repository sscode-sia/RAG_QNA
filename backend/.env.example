# ==============================================================================
# AI-Powered Document Q&A System — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit the real `.env` file to version control.
# ==============================================================================

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required. Your Google API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default) or PostgreSQL connection string.
# Examples:
#   sqlite:///./rag_app.db
#   postgresql://user:password@localhost:5432/rag_db
DATABASE_URL=sqlite:///./rag_app.db

# ── Qdrant Vector Database ───────────────────────────────────────────────────
# Set to ":memory:" to use an in-memory instance (no server required).
# Or provide a URL like "http://localhost:6333" for a running Qdrant instance.
QDRANT_URL=:memory:

# ── Optional Overrides ───────────────────────────────────────────────────────
# EMBEDDING_MODEL=models/gemini-embedding-001
# LLM_MODEL=gemini-2.0-flash
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
